    {
      "name": "05 - Segurança (testes separados)",
      "item": [
        {
          "name": "Sem token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/usuario/me",
              "host": [
                "{{host}}"
              ],
              "path": [
                "usuario",
                "me"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 sem JWT', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Token alterado → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/usuario/me",
              "host": [
                "{{host}}"
              ],
              "path": [
                "usuario",
                "me"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "token.invalido.assinatura",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 com JWT inválido', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "USER consulta outro ID → 403",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/usuario/{{outro_usuario_id}}",
              "host": [
                "{{host}}"
              ],
              "path": [
                "usuario",
                "{{outro_usuario_id}}"
              ]
            },
            "description": "Configure outro_usuario_id com um usuário existente diferente do usuário logado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 usuário diferente', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login ADMIN → substituir JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/login",
              "host": [
                "{{host}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Use um ADMIN existente. Este login substitui authorization_token da collection.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_email}}\",\n  \"password\": \"{{admin_senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login retornou 200', () => pm.response.to.have.status(200));",
                  "const authHeader = pm.response.headers.get('Authorization');",
                  "const json = pm.response.json();",
                  "const token = (authHeader && authHeader.startsWith('Bearer ') ? authHeader.substring(7) : json.token);",
                  "pm.test('Token retornado', () => pm.expect(token).to.be.a('string').and.not.empty);",
                  "if (token) pm.collectionVariables.set('authorization_token', token);",
                  "console.log('Token JWT salvo na variável authorization_token (não compartilhe o valor).');"
                ]
              }
            }
          ]
        },
        {
          "name": "ADMIN consulta outro ID → 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/usuario/{{outro_usuario_id}}",
              "host": [
                "{{host}}"
              ],
              "path": [
                "usuario",
                "{{outro_usuario_id}}"
              ]
            },
            "description": "Executar após fazer login como ADMIN."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Não expõe senha/CPF/perfis internos', () => {",
                  "  pm.expect(body).not.to.have.property('senha');",
